# Clerk: dashboard.clerk.com > your application > API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase: click Connect at the top of your project > Server, and copy these two.
# The publishable key it also shows isn't needed.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: where the app runs, used in admin invitation links
APP_URL=http://localhost:3000

# Trigger.dev: dashboard > your project > API keys. Create a key with the "Waitpoints only"
# preset, so approving a welcome email can resume the agent.
TRIGGER_SECRET_KEY=

# Gemini: aistudio.google.com > Get API key
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: the Gemini model; defaults to gemini-3.8-flash
GEMINI_MODEL=

# Zoho CPaaS: your Mail Agent > SMTP/API > Send Mail token
ZOHO_CPAAS_TOKEN=
ZOHO_CPAAS_FROM_ADDRESS=
ZOHO_CPAAS_FROM_NAME=Brandnote
